// Minimal Core-level protected-call preflight, explicit guest-error arm.
// Exact RSS guest input. Not compiled or run in this slice.
//
// This is not a Core VmError. It is a guest value with tag false and the
// original object x in position 1. The parent continues after the call.

fn mark(phase: int) -> int;

fn error_arm(x: [int]) -> [bool, [int]] {
    mark(1);
    [false, x]
}

fn parent(
    held: fn([int]) -> [bool, [int]],
    t: [int],
    do_call: bool,
) -> [[bool, [int]], int, int, bool, [int]] {
    mark(0);
    let empty: [int] = [0];
    let r: [bool, [int]] = if do_call => { held(t) } else => { [false, empty] };
    mark(2);
    let arity = len(r);
    let tag = r[0];
    let marker = if do_call => { 1 } else => { 0 };
    [r, arity, marker, tag, t]
}

let t: [int] = [7, 8];
let held: fn([int]) -> [bool, [int]] = error_arm;
parent(held, t, true);
