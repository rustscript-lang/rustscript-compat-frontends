// Minimal Core-level protected-call preflight, omitted-call arm.
// Exact RSS guest input. Not compiled or run in this slice.
//
// Same program, same held callable, but do_call is false. The callable must
// not run: mark(1) is absent and the payload is not the original t.

fn mark(phase: int) -> int;

fn ok_arm(x: [int]) -> [bool, [int]] {
    mark(1);
    [true, x]
}

fn parent(
    held: fn([int]) -> [bool, [int]],
    t: [int],
    do_call: bool,
) -> [[bool, [int]], int, int, bool, [int]] {
    mark(0);
    let empty: [int] = [0];
    let r: [bool, [int]] = if do_call => { held(t) } else => { [false, empty] };
    mark(2);
    let arity = len(r);
    let tag = r[0];
    let marker = if do_call => { 1 } else => { 0 };
    [r, arity, marker, tag, t]
}

let t: [int] = [7, 8];
let held: fn([int]) -> [bool, [int]] = ok_arm;
parent(held, t, false);
